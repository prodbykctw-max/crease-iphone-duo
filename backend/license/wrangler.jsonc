{
  "name": "crease-license",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  // Live sales go through Stripe (STRIPE_PRICE_ID + SALES_START below). The Lemon Squeezy ids stay empty:
  // while STORE_ID or PRODUCT_ID is empty the Worker refuses every Lemon Squeezy request (503), and Stripe is
  // unaffected. SALES_START and the ids must match assets/commerce-config.js; tests/checkout.test.mjs fails if they drift.
  "vars": {
    "ALLOWED_ORIGINS": "https://prodbykctw-max.github.io,https://playcrease.app,https://www.playcrease.app",
    "STORE_ID": "",
    "PRODUCT_ID": "",
    "VARIANT_ID": "",
    // When the Pass went on sale. It no longer decides Founder's Gold (that is free, by code: founder-codes.mjs).
    "SALES_START": "2026-11-06T06:18:00Z",
    // Stripe: the live price id of CREASE Premium. Empty means the Stripe routes refuse everything (503).
    "STRIPE_PRICE_ID": "price_1UYfWOAKvkJ3OCtSYfn5mERx"
  },
  // Secrets (never in this file): wrangler secret put SIGNING_SECRET, and for Stripe wrangler secret put
  // STRIPE_KEY (a LIVE restricted key, read-only: Checkout Sessions, Charges, PaymentIntents). A test key
  // here would accept sandbox purchases, so the Worker only honours sessions whose mode matches the key.
  // Device counts for Stripe sales (schema.sql). Apply with: wrangler d1 execute crease-license --remote --file schema.sql
  "d1_databases": [
    { "binding": "DB", "database_name": "crease-license", "database_id": "4faeb3e8-72e7-4728-b3c6-249026c067f4" }
  ],
  // Per-IP and Worker-wide limits keep us under Lemon Squeezy's 60 License API calls a minute.
  "ratelimits": [
    { "name": "PER_IP", "namespace_id": "4004", "simple": { "limit": 10, "period": 60 } },
    { "name": "ALL_TRAFFIC", "namespace_id": "4005", "simple": { "limit": 25, "period": 60 } }
  ]
}
