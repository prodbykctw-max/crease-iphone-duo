{
  "name":"crease-online",
  "main":"worker.mjs",
  "compatibility_date":"2026-09-22",
  // Every origin allowed to open a match. Add your custom domain here too.
  "vars":{"ALLOWED_ORIGINS":"https://prodbykctw-max.github.io,http://localhost:8787,http://127.0.0.1:8787,http://127.0.0.1:8765"},
  "durable_objects":{"bindings":[
    {"name":"ROOMS","class_name":"Room"},
    {"name":"LOBBY","class_name":"Lobby"}
  ]},
  "migrations":[
    {"tag":"v1","new_sqlite_classes":["Room"]},
    {"tag":"v2","new_sqlite_classes":["Lobby"]}
  ]
}
